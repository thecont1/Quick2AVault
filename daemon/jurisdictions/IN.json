{
  "id": "IN",
  "version": "1.0.0",
  "name": "India",
  "locale": "en-IN",

  "financial_year": {
    "start_month": 4,
    "start_day": 1,
    "label_format": "FY {start}-{end2}",
    "description": "1 April – 31 March"
  },

  "currency": {
    "code": "INR",
    "symbol": "₹",
    "minor_units": 2,
    "grouping": "lakh_crore",
    "grouping_description": "₹1,42,356.28 — last 3 digits, then pairs"
  },

  "dates": {
    "input_format": "DD-MM-YYYY",
    "display_format": "DD MMM YYYY",
    "note": "Source documents write 06-08-2026 meaning 6 August 2026."
  },

  "tax_ids": {
    "PAN": "[A-Z]{5}[0-9]{4}[A-Z]",
    "GSTIN": "[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][0-9A-Z]{3}",
    "TAN": "[A-Z]{4}[0-9]{5}[A-Z]",
    "CIN": "[LU][0-9]{5}[A-Z]{2}[0-9]{4}[A-Z]{3}[0-9]{6}"
  },

  "entity_suffixes": [
    "pvt", "private", "ltd", "limited", "llp", "inc", "co", "company",
    "corporation", "corp", "enterprises", "industries"
  ],

  "statutory_buckets": ["GST", "TDS", "TCS", "cess", "stamp_duty", "STT"],

  "impact_buckets": [
    "income", "spending", "investment", "transfer", "tax", "refund"
  ],

  "payment_rails": [
    "upi", "card", "netbanking", "auto_debit", "cheque", "cash", "broker", "neft", "imps", "rtgs"
  ],

  "settlement_windows_days": {
    "card": 3,
    "upi": 1,
    "netbanking": 2,
    "cheque": 5,
    "default": 2
  },

  "fx": {
    "source": "frankfurter",
    "home_currency": "INR",
    "fallback": "prior_business_day"
  },

  "document_hints": {
    "wallet_topup": ["ADD MONEY", "LOAD", "TOP-UP", "TOPUP", "WALLET"],
    "contract_note": ["CONTRACT NOTE", "TRADE CONFIRMATION", "NSE", "BSE", "ISIN"],
    "salary": ["PAYSLIP", "SALARY SLIP", "EARNINGS", "NET PAY", "CTC"],
    "bank_statement": ["STATEMENT OF ACCOUNT", "ACCOUNT STATEMENT", "OPENING BALANCE", "CLOSING BALANCE", "NARRATION"],
    "card_statement": ["CREDIT CARD STATEMENT", "STATEMENT SUMMARY", "MINIMUM AMOUNT DUE", "TOTAL AMOUNT DUE", "PAYMENT DUE DATE"]
  }
}
