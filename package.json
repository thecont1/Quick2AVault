{
  "name": "quick2avault",
  "version": "2.0.0",
  "productName": "Quick2AVault",
  "description": "Local-first financial document vault: a daemon that reads your documents, and a Flutter desktop client that lets you correct it.",
  "private": true,
  "type": "module",
  "scripts": {
    "daemon": "tsx daemon/main.ts",
    "daemon:dev": "tsx watch daemon/main.ts",
    "migrate:glaze": "tsx daemon/migrate-glaze.ts",
    "test": "for f in daemon/*.smoke.ts; do echo \"── $f\"; tsx \"$f\" || exit 1; done",
    "lint": "eslint daemon --ext .ts",
    "type-check": "tsc --noEmit -p daemon/tsconfig.json",
    "format": "oxfmt daemon",
    "app": "cd desktop && flutter run -d macos",
    "app:build": "cd desktop && flutter build macos --release",
    "app:test": "cd desktop && flutter test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@firecrawl/anydoc": "0.1.6",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.31.0",
    "oxfmt": "^0.26.0",
    "tsx": "^4.20.5",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "packageManager": "npm@11.11.0+sha512-82gRxKrh/eY5UnNorkTFcdBQAGpgjWehkfGVqAGlJjejEtJZGGJUqjo3mbBTNbc5BTnPKGVtGPBZGhElujX5cw=="
}
